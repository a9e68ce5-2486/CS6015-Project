msdscript_ui.pro:
qmake: FORCE
	@$(QMAKE) -o Makefile msdscript_ui.pro

qmake_all: FORCE

msdscript_ui.app/Contents/PkgInfo: 
	@test -d msdscript_ui.app/Contents || mkdir -p msdscript_ui.app/Contents
	@$(DEL_FILE) msdscript_ui.app/Contents/PkgInfo
	@echo "APPL????" > msdscript_ui.app/Contents/PkgInfo
msdscript_ui.app/Contents/Resources/empty.lproj: 
	@test -d msdscript_ui.app/Contents/Resources || mkdir -p msdscript_ui.app/Contents/Resources
	@touch msdscript_ui.app/Contents/Resources/empty.lproj
	
msdscript_ui.app/Contents/Info.plist: 
	@test -d msdscript_ui.app/Contents || mkdir -p msdscript_ui.app/Contents
	@$(DEL_FILE) msdscript_ui.app/Contents/Info.plist
	@sed -e "s,@SHORT_VERSION@,1.0,g" -e "s,\$${QMAKE_SHORT_VERSION},1.0,g" -e "s,@FULL_VERSION@,1.0.0,g" -e "s,\$${QMAKE_FULL_VERSION},1.0.0,g" -e "s,@TYPEINFO@,????,g" -e "s,\$${QMAKE_PKGINFO_TYPEINFO},????,g" -e "s,@BUNDLEIDENTIFIER@,msd.msdscript-ui,g" -e "s,\$${PRODUCT_BUNDLE_IDENTIFIER},msd.msdscript-ui,g" -e "s,\$${MACOSX_DEPLOYMENT_TARGET},10.13,g" -e "s,\$${IPHONEOS_DEPLOYMENT_TARGET},,g" -e "s,\$${TVOS_DEPLOYMENT_TARGET},,g" -e "s,\$${WATCHOS_DEPLOYMENT_TARGET},,g" -e "s,@ICON@,,g" -e "s,\$${ASSETCATALOG_COMPILER_APPICON_NAME},,g" -e "s,@EXECUTABLE@,msdscript_ui,g" -e "s,@LIBRARY@,msdscript_ui,g" -e "s,\$${EXECUTABLE_NAME},msdscript_ui,g" -e "s,@TYPEINFO@,????,g" -e "s,\$${QMAKE_PKGINFO_TYPEINFO},????,g" /opt/anaconda3/mkspecs/macx-clang/Info.plist.app >msdscript_ui.app/Contents/Info.plist

all: Makefile \
		msdscript_ui.app/Contents/PkgInfo \
		msdscript_ui.app/Contents/Resources/empty.lproj \
		msdscript_ui.app/Contents/Info.plist msdscript_ui.app/Contents/MacOS/msdscript_ui

dist: distdir FORCE
	(cd `dirname $(DISTDIR)` && $(TAR) $(DISTNAME).tar $(DISTNAME) && $(COMPRESS) $(DISTNAME).tar) && $(MOVE) `dirname $(DISTDIR)`/$(DISTNAME).tar.gz . && $(DEL_FILE) -r $(DISTDIR)

distdir: FORCE
	@test -d $(DISTDIR) || mkdir -p $(DISTDIR)
	$(COPY_FILE) --parents $(DIST) $(DISTDIR)/
	$(COPY_FILE) --parents /opt/anaconda3/mkspecs/features/data/dummy.cpp $(DISTDIR)/
	$(COPY_FILE) --parents msdWidget.h msdscript_core/env.h msdscript_core/expr.h msdscript_core/parse.h msdscript_core/pointer.h msdscript_core/val.h $(DISTDIR)/
	$(COPY_FILE) --parents main.cpp msdWidget.cpp msdscript_core/env.cpp msdscript_core/expr.cpp msdscript_core/parse.cpp msdscript_core/val.cpp $(DISTDIR)/


clean: compiler_clean 
	-$(DEL_FILE) $(OBJECTS)
	-$(DEL_FILE) *~ core *.core


distclean: clean 
	-$(DEL_FILE) -r msdscript_ui.app
	-$(DEL_FILE) .qmake.stash
	-$(DEL_FILE) Makefile


